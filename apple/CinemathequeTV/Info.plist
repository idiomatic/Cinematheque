<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Cinematheque</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Repositories are often plain HTTP on the local network. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cinematheque plays videos from repositories on your network, and syncs with your other devices there.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_cinematheque._tcp</string>
	</array>
</dict>
</plist>
