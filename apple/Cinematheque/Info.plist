<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.rbrian.cinematheque</string>
	<key>CFBundleName</key>
	<string>Cinematheque</string>
	<key>CFBundleDisplayName</key>
	<string>Cinematheque</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Sources are often plain HTTP on the local network. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cinematheque plays videos from sources on your network, and syncs with your other devices there.</string>
#if TVOS
	<!-- No apostrophes in this file: it is preprocessed, which reads one
	     as a character constant. Links into the app, as the Top Shelf of the
	     Apple TV opens a title: on
	     tvOS only, as the Mac handles none, and would open a window for
	     each. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.rbrian.cinematheque</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cinematheque</string>
			</array>
		</dict>
	</array>
#endif
	<!-- Asking whether VLC is installed, for copies Apple players cannot play (VLC.swift). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>vlc-x-callback</string>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_cinematheque._tcp</string>
		<!-- For the mock library (CINEMATHEQUE_DNSSD), in tests and screenshots: no apostrophes, as the preprocessor reads one as a character literal. -->
		<string>_cinemock._tcp</string>
	</array>
</dict>
</plist>
