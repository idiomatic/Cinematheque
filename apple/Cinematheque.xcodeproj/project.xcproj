{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "folder",
      "path": "Cinematheque",
      "target-membership": [
        "Cinematheque",
      ],
      "membership-exceptions": [
        {
          "target": "Cinematheque",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "path": "build-core.zsh" },
    { "path": "Signing.xcconfig" },
    { "path": "Cinematheque.entitlements" },
    { "path": "TopShelf.entitlements" },
    {
      "kind": "folder",
      "path": "TopShelf",
      "target-membership": [
        "TopShelf",
      ],
      "membership-exceptions": [
        {
          "target": "TopShelf",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<DEVELOPER>/Library/Frameworks/TVServices.framework", "target-membership": [ "TopShelf/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Cinematheque.app", "id": "00C1E0000000000000000003", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/TopShelf.appex", "id": "D393C48D30B0303500241D38", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Cinematheque/copy/Embed Foundation Extensions", "platforms": [ "tvos" ], "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Cinematheque",
      "id": "00C1E0000000000000000006",
      "product": "Products/Cinematheque.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": "Signing.xcconfig" },
        { "name": "Release", "file": "Signing.xcconfig" },
      ],
      "dependencies": [
        { "target": "TopShelf", "platforms": [ "tvos" ] },
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Build the core",
          "output-paths": [
            "$(DERIVED_FILE_DIR)/core/lib/libcinematheque.a",
          ],
          "run-on-every-build": true,
          "shell": "/bin/zsh",
          "script": "\"$SRCROOT/build-core.zsh\"\n",
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME[sdk=appletv*]": "App Icon & Top Shelf Image",
        "ASSETCATALOG_COMPILER_APPICON_NAME[sdk=macosx*]": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS[sdk=appletv*]": "Cinematheque.entitlements",
        "CODE_SIGN_IDENTITY[sdk=macosx*]": "-",
        "CODE_SIGN_STYLE[sdk=appletv*]": "Automatic",
        "CODE_SIGN_STYLE[sdk=macosx*]": "Manual",
        "COMBINE_HIDPI_IMAGES[sdk=macosx*]": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "DEAD_CODE_STRIPPING": "YES",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "NO",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Cinematheque/Info.plist",
        "INFOPLIST_KEY_LSApplicationCategoryType[sdk=macosx*]": "public.app-category.entertainment",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=appletv*]": "YES",
        "INFOPLIST_PREPROCESS": "YES",
        "INFOPLIST_PREPROCESSOR_DEFINITIONS[sdk=appletv*]": "TVOS",
        "LD_RUNPATH_SEARCH_PATHS[sdk=appletv*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "LIBRARY_SEARCH_PATHS": "$(DERIVED_FILE_DIR)/core/lib",
        "MARKETING_VERSION": "0.1",
        "OTHER_LDFLAGS": "-lsqlite3",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.rbrian.cinematheque",
        "PRODUCT_NAME": "Cinematheque",
        "SDKROOT": "auto",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "macosx appletvos appletvsimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_INCLUDE_PATHS": "$(SRCROOT)/../core/include",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "3",
        "TVOS_DEPLOYMENT_TARGET": "18.0",
      },
    }, {
      "name": "TopShelf",
      "id": "D393C48C30B0303500241D38",
      "product": "Products/TopShelf.appex",
      "product-type": "app-extension",
      "specialized-configurations": [
        { "name": "Debug", "file": "Signing.xcconfig" },
        { "name": "Release", "file": "Signing.xcconfig" },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "TopShelf.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "TopShelf/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Cinematheque",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "MARKETING_VERSION": "0.1",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.rbrian.cinematheque.TopShelf",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "appletvos",
        "SKIP_INSTALL": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "3",
        "TVOS_DEPLOYMENT_TARGET": "18.0",
        "VALIDATE_PRODUCT[config=Release]": "YES",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "15.0",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "macosx",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
  },
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
